        document.querySelectorAll('#mobile-menu a').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        // --- Arabic Letters Background Animation ---
        function createFloatingLetters() {
            const container = document.getElementById('arabic-letters-bg');
            if (!container) return;

            const letters = ['ا', 'ب', 'ت', 'ث', 'ج', 'ح', 'خ', 'د', 'ذ', 'ر', 'ز', 'س', 'ش', 'ص', 'ض', 'ط', 'ظ', 'ع', 'غ', 'ف', 'ق', 'ك', 'ل', 'م', 'ن', 'ه', 'و', 'ي'];
            const numberOfLetters = 50; // Jumlah huruf yang ditampilkan

            for (let i = 0; i < numberOfLetters; i++) {
                const letterSpan = document.createElement('span');
                letterSpan.className = 'arabic-letter';
                letterSpan.textContent = letters[Math.floor(Math.random() * letters.length)];

                // Properti acak untuk setiap huruf
                const size = Math.random() * 4 + 2; // Ukuran font antara 2rem dan 6rem
                const left = Math.random() * 100; // Posisi horizontal acak
                const duration = Math.random() * 30 + 20; // Durasi animasi antara 20-50 detik
                const delay = Math.random() * 20; // Penundaan animasi antara 0-20 detik

                letterSpan.style.fontSize = `${size}rem`;
                letterSpan.style.left = `${left}vw`;
                letterSpan.style.animationDuration = `${duration}s`;
                letterSpan.style.animationDelay = `${delay}s`;

                container.appendChild(letterSpan);
            }
        }
        
        // Jalankan fungsi setelah halaman dimuat
        document.addEventListener('DOMContentLoaded', createFloatingLetters);
        
        // Video Modal Logic
        const videoModalTriggers = document.querySelectorAll('.video-modal-trigger');
        const modal = document.getElementById('video-modal');
        const modalClose = document.getElementById('modal-close');
        const modalOverlay = document.querySelector('.modal-overlay');
        const videoPlayer = document.getElementById('video-player');

        function openModal(videoId) {
            videoPlayer.innerHTML = `<iframe src="https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen class="w-full h-full absolute top-0 left-0"></iframe>`;
            modal.classList.remove('opacity-0', 'pointer-events-none');
            document.body.classList.add('modal-active');
        }

        function closeModal() {
            videoPlayer.innerHTML = '';
            modal.classList.add('opacity-0', 'pointer-events-none');
            document.body.classList.remove('modal-active');
        }

        videoModalTriggers.forEach(button => {
            button.addEventListener('click', () => {
                const videoId = button.getAttribute('data-video-id');
                openModal(videoId);
            });
        });

        modalClose.addEventListener('click', closeModal);
        modalOverlay.addEventListener('click', closeModal);
        
        document.addEventListener('keydown', (e) => {
            if (e.key === "Escape") {
                closeModal();
            }
        });

        // --- Scroll Animation Logic ---
        const animatedElements = document.querySelectorAll('.animate-on-scroll');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target); // Animate only once
                }
            });
        }, {
            threshold: 0.1, // Trigger when 10% of the element is visible
        });

        animatedElements.forEach(el => {
            observer.observe(el);
        });

    </script>
</body>
</html>
