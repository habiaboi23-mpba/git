    <style type="text/tailwindcss">
        @layer base {
            body {
                font-family: 'Poppins', sans-serif;
            }
        }
        @layer utilities {
            .animation-fade-in {
                animation: fadeIn 1s ease-in-out;
            }
            @keyframes fadeIn {
                0% { opacity: 0; transform: translateY(20px); }
                100% { opacity: 1; transform: translateY(0); }
            }
            .smooth-scroll {
                scroll-behavior: smooth;
            }
            .card-hover {
                @apply transition-all duration-300 ease-in-out transform hover:-translate-y-2 hover:shadow-2xl;
            }
            .button-hover {
                @apply transition-all duration-300 ease-in-out transform hover:scale-105;
            }
            .modal {
                transition: opacity 0.25s ease;
            }
            body.modal-active {
                overflow-x: hidden;
                overflow-y: hidden;
            }

            /* --- Animasi Gulir Ditambahkan --- */
            .animate-on-scroll {
                opacity: 0;
                transform: translateY(30px);
                transition: opacity 0.7s ease-out, transform 0.7s ease-out;
                will-change: opacity, transform;
            }
            .animate-on-scroll.is-visible {
                opacity: 1;
                transform: translateY(0);
            }
            
            /* --- Animasi Huruf Arab Mengambang --- */
            @keyframes floatUp {
                0% {
                    transform: translateY(0);
                    opacity: 0;
                }
                10%, 90% {
                    opacity: 0.2; /* Opacity saat muncul dan menghilang */
                }
                100% {
                    transform: translateY(-100vh); /* Bergerak ke atas sejauh tinggi layar */
                    opacity: 0;
                }
            }

            .arabic-letter {
                position: absolute;
                color: #f9b759; /* Warna brand-gold */
                user-select: none;
                pointer-events: none;
                animation-name: floatUp;
                animation-timing-function: linear;
                animation-iteration-count: infinite;
                top: 100%; /* Mulai dari bawah kontainer */
            }
        }
    </style>
